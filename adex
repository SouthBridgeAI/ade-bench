#!/usr/bin/env bash
# adex - wrapper around `ade` that authenticates the installed agents via local
# OAuth credential files instead of API keys.
#
#   Claude Code: .claude-credentials.json  (unsets ANTHROPIC_API_KEY)
#   OpenAI Codex: .codex-auth.json         (unsets OPENAI_API_KEY)
#
# At least one credential file must be present. Each file that is present is
# validated (its OAuth access token must not be expired) and the matching API
# key env var is unset, then all arguments are forwarded to `ade`.
#
# Refresh stale Claude credentials on the host:
#   claude    # then /logout, exit, relaunch to /login
#   security find-generic-password -s 'Claude Code-credentials' -w \
#     > .claude-credentials.json && chmod 600 .claude-credentials.json
#
# Refresh stale Codex credentials on the host:
#   codex login    # complete the ChatGPT browser login
#   cp ~/.codex/auth.json .codex-auth.json && chmod 600 .codex-auth.json

set -euo pipefail

SCRIPT_DIR="$(python3 -c "import os,sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))" "${BASH_SOURCE[0]}")"
CREDS="${SCRIPT_DIR}/.claude-credentials.json"
CODEX_CREDS="${SCRIPT_DIR}/.codex-auth.json"

if [[ ! -f "$CREDS" && ! -f "$CODEX_CREDS" ]]; then
  echo "adex: no credentials file found." >&2
  echo "      Claude: security find-generic-password -s 'Claude Code-credentials' -w > '$CREDS' && chmod 600 '$CREDS'" >&2
  echo "      Codex:  cp ~/.codex/auth.json '$CODEX_CREDS' && chmod 600 '$CODEX_CREDS'" >&2
  exit 1
fi

python3 - "$CREDS" "$CODEX_CREDS" <<'PYEOF'
import base64, datetime, json, os, sys, time

claude_path, codex_path = sys.argv[1], sys.argv[2]


def fail(msg, code):
    print(msg, file=sys.stderr)
    sys.exit(code)


if os.path.isfile(claude_path):
    try:
        exp_ms = json.load(open(claude_path))["claudeAiOauth"]["expiresAt"]
    except (KeyError, ValueError, OSError) as e:
        fail(f"adex: Claude credentials file is malformed: {e}", 2)
    delta_min = (exp_ms / 1000 - time.time()) / 60
    if delta_min <= 0:
        iso = datetime.datetime.fromtimestamp(exp_ms / 1000).isoformat()
        fail(
            f"adex: Claude OAuth access token expired ({iso}, {abs(delta_min):.0f} min ago)\n"
            "      Refresh on host (claude, /logout, relaunch, /login), then re-extract:\n"
            f"      security find-generic-password -s 'Claude Code-credentials' -w > {claude_path} && chmod 600 {claude_path}",
            3,
        )

if os.path.isfile(codex_path):
    try:
        access_token = json.load(open(codex_path))["tokens"]["access_token"]
        payload = access_token.split(".")[1]
        payload += "=" * (-len(payload) % 4)
        exp_sec = json.loads(base64.urlsafe_b64decode(payload))["exp"]
    except (KeyError, IndexError, ValueError, OSError) as e:
        fail(f"adex: Codex credentials file is malformed: {e}", 2)
    delta_min = (exp_sec - time.time()) / 60
    if delta_min <= 0:
        iso = datetime.datetime.fromtimestamp(exp_sec).isoformat()
        fail(
            f"adex: Codex OAuth access token expired ({iso}, {abs(delta_min):.0f} min ago)\n"
            "      Refresh on host (codex login), then re-extract:\n"
            f"      cp ~/.codex/auth.json {codex_path} && chmod 600 {codex_path}",
            3,
        )
PYEOF

if [[ -f "$CREDS" ]]; then
  unset ANTHROPIC_API_KEY
fi
if [[ -f "$CODEX_CREDS" ]]; then
  unset OPENAI_API_KEY
fi
exec uv run --project "$SCRIPT_DIR" ade "$@"
